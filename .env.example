# ---------------------------------------------------------------------------
# Alpha Sigma Phi – Theta Tau · Environment variables
# Copy this file to `.env.local` and fill in values. NEVER commit `.env.local`.
# ---------------------------------------------------------------------------

# Public base URL of the deployed site (used for SEO / OpenGraph / sitemap).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: override just the newsletter link without editing code.
# NEXT_PUBLIC_NEWSLETTER_URL=https://example.com/newsletters/fall-2026.pdf

# ---------------------------------------------------------------------------
# Google Calendar sync (optional)
# When set, the Events page + homepage pull live from this iCal (.ics) feed
# instead of src/data/events.ts. Recurring events are expanded automatically.
# In Google Calendar: Settings → your calendar → "Integrate calendar" →
# copy the "Secret address in iCal format" (works for a private calendar) or
# the public iCal URL. Leave unset to use the built-in static events.
# ---------------------------------------------------------------------------
# GOOGLE_CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/xxxxxxxx/private-xxxx/basic.ics
# How far ahead to show events, in months (default 12).
# GOOGLE_CALENDAR_MONTHS_AHEAD=12
# Feed cache time in seconds (default 3600 = 1 hour).
# GOOGLE_CALENDAR_REVALIDATE=3600

# ---------------------------------------------------------------------------
# Roster sync via published Google Sheet (optional)
# When set, the Brothers directory pulls live from this sheet instead of
# src/data/brothers.ts. In Google Sheets: File → Share → Publish to web →
# choose the roster tab → CSV → copy the URL. Pair with a Google Form whose
# responses populate the sheet to keep the roster current.
# Columns (header row): First Name, Last Name, Class Year, Major, Position,
# Bio, Image URL, Executive Board (yes/no), Active (yes/no), Display Order.
# ---------------------------------------------------------------------------
# GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/XXXX/pub?gid=0&single=true&output=csv
# Sheet cache time in seconds (default 3600 = 1 hour).
# GOOGLE_SHEET_REVALIDATE=3600

# ---------------------------------------------------------------------------
# Admin authentication (required in production)
# ---------------------------------------------------------------------------

# Password officers use to sign in at /admin/login.
ADMIN_PASSWORD=choose-a-strong-password

# Secret used to sign the admin session cookie. Must be >= 16 chars.
# Generate one with:  openssl rand -base64 32
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Feature flags (optional overrides; code defaults are in src/config/features.ts)
# Accepts: true/false, 1/0, on/off, yes/no. Env wins over the admin toggle.
# ---------------------------------------------------------------------------
# FEATURE_POTLUCK=true
# FEATURE_BROTHERS=true
# FEATURE_EVENTS=true
# FEATURE_NEWSLETTER=true
# FEATURE_ABOUT=true

# ---------------------------------------------------------------------------
# Data store location (optional)
# Where the JSON store (potluck sign-ups + feature overrides) is written.
# Defaults to ./.data locally and the OS temp dir on Vercel.
# ---------------------------------------------------------------------------
# DATA_DIR=/absolute/path/to/writable/dir
